{
  "rules": {
    ".read": false,
    ".write": false,
    "plazaV2": {
      "$slot": {
        ".read": "auth != null && (auth.token.firebase.sign_in_provider === 'google.com' || auth.token.firebase.sign_in_provider === 'anonymous') && data.child('owner').val() === auth.uid",
        ".write": "auth != null && (auth.token.firebase.sign_in_provider === 'google.com' || auth.token.firebase.sign_in_provider === 'anonymous') && $slot.matches(/^[0-7]$/) && ((!newData.exists() && data.child('owner').val() === auth.uid) || (newData.child('owner').val() === auth.uid && (!data.exists() || data.child('pose').child('at').val() < now - 45000 || (data.child('owner').val() === auth.uid && data.child('pose').child('session').val() === newData.child('pose').child('session').val()))))",
        ".validate": "newData.hasChildren(['owner','pose'])",
        "owner": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "pose": {
          ".read": "auth != null && (auth.token.firebase.sign_in_provider === 'google.com' || auth.token.firebase.sign_in_provider === 'anonymous')",
          ".validate": "newData.hasChildren(['session','x','y','action','flip','at','nickname'])",
          "session": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f-]{36}$/)"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() >= 28 && newData.val() <= 932"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() >= 28 && newData.val() <= 478"
          },
          "action": {
            ".validate": "newData.isString() && newData.val().matches(/^(idle|walk|special|attack|damage|death)$/)"
          },
          "flip": {
            ".validate": "newData.isBoolean()"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() >= now - 5000 && newData.val() <= now + 5000"
          },
